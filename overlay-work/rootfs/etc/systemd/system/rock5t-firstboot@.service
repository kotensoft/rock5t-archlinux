[Unit]
Description=Secure ROCK5T first-boot setup on %I
After=local-fs.target systemd-user-sessions.service
ConditionPathExists=!/var/lib/rock5t/provisioned
Before=getty@%i.service serial-getty@%i.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/rock5t-firstboot %I
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/%I
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=no
Restart=on-failure
RestartSec=3
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
