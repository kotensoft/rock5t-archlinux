#!/usr/bin/bash
# Only plain, last-on-disk ext4 root partitions are supported. No LVM/LUKS/RAID.
set -Eeuo pipefail
export PATH=/usr/bin:/usr/sbin
(( EUID == 0 )) || { echo 'Run this as root.' >&2; exit 1; }
[[ $(findmnt -n -o FSTYPE /) == ext4 ]] || { echo 'Root is not ext4.' >&2; exit 1; }
root=$(findmnt -n -o SOURCE /)
root=$(readlink -f "$root")
[[ -b $root && $(lsblk -dn -o TYPE "$root") == part ]] || { echo 'Root must be a plain disk partition.' >&2; exit 1; }
parent=$(lsblk -dn -o PKNAME "$root")
part=$(cat "/sys/class/block/${root##*/}/partition")
[[ $parent =~ ^[a-zA-Z0-9_-]+$ && $part =~ ^[0-9]+$ ]] || exit 1
disk=/dev/$parent
[[ $(lsblk -dn -o TYPE "$disk") == disk ]] || exit 1
command -v growpart >/dev/null || { echo 'Install cloud-guest-utils to enable expansion.' >&2; exit 1; }
# Use actual on-disk start/end values, not partition numbers, to identify last.
sfdisk --json "$disk" | python -c '
import json,sys
p=json.load(sys.stdin)["partitiontable"]["partitions"]
r=[x for x in p if x["node"]==sys.argv[1]]
if len(r)!=1 or r[0]["start"]+r[0]["size"] != max(x["start"]+x["size"] for x in p):
    sys.exit("Refusing: root is not the last partition on the disk.")
' "$root"
# Exit 1 means no space left to grow; accept only the documented NOCHANGE output.
log=$(mktemp /run/rock5t-grow.XXXXXX)
trap 'rm -f "$log"' EXIT
if growpart "$disk" "$part" >"$log" 2>&1; then
    cat "$log"
else
    rc=$?; cat "$log"
    [[ $rc == 1 ]] && grep -q '^NOCHANGE:' "$log" || exit "$rc"
fi
udevadm settle
resize2fs "$root"
